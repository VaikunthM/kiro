{
  "enabled": true,
  "name": "Run brain tests on save",
  "description": "When a brain or policy file changes, run the P3 tests and report failures.",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": ["brain/**/*.py", "policies/*.py", "tests/test_brain.py"]
  },
  "then": {
    "type": "askAgent",
    "prompt": "Run `python tests/test_brain.py` and report any failing tests. If one fails, explain which behaviour broke."
  }
}
